{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/portfolio",
      "dest": "/portfolio.html"
    },
    {
      "src": "/services",
      "dest": "/services.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
